---
import { getCollection, getEntry } from 'astro:content';
import EntryRow from '~/components/lists/EntryRow.astro';
import ExternalLink from '~/components/lists/ExternalLink.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatDate, formatYearMonth } from '~/lib/format';
import { publicationTypeLabel, talkTypeLabel, workCategoryLabel } from '~/lib/labels';
import { url } from '~/lib/url';

const profileEntry = await getEntry('profile', 'main');
if (!profileEntry) throw new Error('profile/main.json が見つかりません');
const profile = profileEntry.data;
const lede = profile.bio_md.split(/\n\n+/u)[0] ?? '';

// /works/ と同じ並び（ピックアップ = priority 昇順 → 最終更新の新しい順）の先頭 1 件。
const pickups = (await getCollection('works'))
  .sort((a, b) => {
    const pa = a.data.priority ?? Number.POSITIVE_INFINITY;
    const pb = b.data.priority ?? Number.POSITIVE_INFINITY;
    if (pa !== pb) return pa - pb;
    return b.data.updated.localeCompare(a.data.updated);
  })
  .slice(0, 1);

const talks = (await getCollection('talks'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 1);
const publications = (await getCollection('publications'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 1);
const careerEntries = (await getCollection('career'))
  .sort((a, b) => b.data.period_start.localeCompare(a.data.period_start))
  .slice(0, 1);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name_ja,
  alternateName: profile.name_en,
  description: profile.tagline,
  url: Astro.site?.toString(),
  sameAs: profile.links.map((l) => l.url),
};
---

<BaseLayout
  title="波多野 卓磨"
  description={`${profile.tagline}。経歴・発表・論文・所属の起点となる自己紹介サイト。`}
  path="/"
  ogType="website"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <section class="hero">
    <p class="kana">Hatano Takuma</p>
    <h1>{profile.name_ja}</h1>
    <p class="tagline">{profile.tagline}</p>

    {lede && <p class="lede">{lede}</p>}

    {profile.links.length > 0 && (
      <ul class="hero-links">
        {profile.links.map((l) => (
          <li>
            <ExternalLink href={l.url}>{l.label}</ExternalLink>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="section preview" aria-labelledby="preview-works">
    <h2 id="preview-works">作成物のピックアップ</h2>
    {pickups.length === 0 ? (
      <p class="empty">作成物はまだありません。</p>
    ) : (
      <ul class="rows">
        {pickups.map((w) => (
          <li>
            <EntryRow date={formatDate(w.data.updated)} dateTime={w.data.updated} badge={workCategoryLabel[w.data.category]}>
              <h3 class="row-title"><ExternalLink href={w.data.site_url} label={w.data.title} /></h3>
              <p class="row-meta">{w.data.summary}</p>
            </EntryRow>
          </li>
        ))}
      </ul>
    )}
    <p class="more"><a href={url('/works/')} aria-label="作成物の詳細はこちら">詳細はこちら →</a></p>
  </section>

  <section class="section preview" aria-labelledby="preview-talks">
    <h2 id="preview-talks">最新の発表</h2>
    {talks.length === 0 ? (
      <p class="empty">まだ登壇情報はありません。</p>
    ) : (
      <ul class="rows">
        {talks.map((t) => (
          <li>
            <EntryRow date={formatDate(t.data.date)} dateTime={t.data.date} badge={talkTypeLabel[t.data.type]}>
              <h3 class="row-title"><a href={url(`/talks/${t.id.replace(/\.md$/u, '')}/`)}>{t.data.title}</a></h3>
              <p class="row-meta">{t.data.event}{t.data.location ? `（${t.data.location}）` : ''}</p>
            </EntryRow>
          </li>
        ))}
      </ul>
    )}
    <p class="more"><a href={url('/talks/')} aria-label="発表の詳細はこちら">詳細はこちら →</a></p>
  </section>

  <section class="section preview" aria-labelledby="preview-pubs">
    <h2 id="preview-pubs">最新の論文・寄稿</h2>
    {publications.length === 0 ? (
      <p class="empty">まだ論文・寄稿はありません。</p>
    ) : (
      <ul class="rows">
        {publications.map((p) => (
          <li>
            <EntryRow date={formatDate(p.data.date)} dateTime={p.data.date} badge={publicationTypeLabel[p.data.type]}>
              <h3 class="row-title"><a href={url(`/publications/${p.id.replace(/\.md$/u, '')}/`)}>{p.data.title}</a></h3>
              <p class="row-meta">{p.data.venue}</p>
            </EntryRow>
          </li>
        ))}
      </ul>
    )}
    <p class="more"><a href={url('/publications/')} aria-label="論文・寄稿の詳細はこちら">詳細はこちら →</a></p>
  </section>

  <section class="section preview" aria-labelledby="preview-career">
    <h2 id="preview-career">経歴</h2>
    <ul class="rows">
      {careerEntries.map((c) => (
        <li>
          <EntryRow date={`${formatYearMonth(c.data.period_start)}〜${formatYearMonth(c.data.period_end)}`}>
            <h3 class="row-title">{c.data.organization}</h3>
            <p class="row-meta">{c.data.role}</p>
          </EntryRow>
        </li>
      ))}
    </ul>
    <p class="more"><a href={url('/career/')} aria-label="経歴の詳細はこちら">詳細はこちら →</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-6);
  }
  .kana {
    color: var(--c-text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .hero h1 {
    font-size: clamp(1.85rem, 1.4rem + 1.6vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    font-weight: 600;
  }
  .tagline {
    margin-top: var(--space-2);
    color: var(--c-text);
    font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
    max-width: var(--measure-prose);
  }
  .lede {
    margin-top: var(--space-4);
    max-width: var(--measure-prose);
  }
  .hero-links {
    list-style: none;
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    font-size: 0.92rem;
  }

  .section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--c-rule);
  }
  .section h2 {
    font-size: 1.15rem;
    margin-bottom: var(--space-4);
    letter-spacing: 0.02em;
  }

  /* Preview sections (works/talks/pubs/career) */
  .rows {
    list-style: none;
  }
  .row-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .row-title a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .row-title a:hover {
    border-bottom-color: var(--c-accent);
  }
  .row-meta {
    color: var(--c-text-muted);
    font-size: 0.92rem;
    margin-top: var(--space-1);
  }
  .more {
    margin-top: var(--space-4);
    color: var(--c-text-muted);
    font-size: 0.92rem;
  }
  .empty {
    color: var(--c-text-muted);
    padding-block: var(--space-3);
  }
</style>

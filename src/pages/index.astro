---
import { getCollection, getEntry } from 'astro:content';
import EntryRow from '~/components/lists/EntryRow.astro';
import ExternalLink from '~/components/lists/ExternalLink.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatDate, formatYearMonth } from '~/lib/format';
import { publicationTypeLabel, talkTypeLabel } from '~/lib/labels';
import { defaultProductIcon } from '~/lib/products';
import { url } from '~/lib/url';

const profileEntry = await getEntry('profile', 'main');
if (!profileEntry) throw new Error('profile/main.json が見つかりません');
const profile = profileEntry.data;
const paragraphs = profile.bio_md.split(/\n\n+/u);
const lede = paragraphs[0] ?? '';
const restBio = paragraphs.slice(1);

const products = (await getCollection('products')).sort((a, b) => {
  const pa = a.data.priority ?? 999;
  const pb = b.data.priority ?? 999;
  if (pa !== pb) return pa - pb;
  const sa = a.data.period_start ?? '';
  const sb = b.data.period_start ?? '';
  return sb.localeCompare(sa);
});

const talks = (await getCollection('talks'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
const publications = (await getCollection('publications'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
const careerEntries = (await getCollection('career'))
  .sort((a, b) => b.data.period_start.localeCompare(a.data.period_start))
  .slice(0, 3);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name_ja,
  alternateName: profile.name_en,
  description: profile.tagline,
  url: Astro.site?.toString(),
  sameAs: profile.links.map((l) => l.url),
};
---

<BaseLayout
  title="畑野 拓馬"
  description={`${profile.tagline}。経歴・発表・論文・所属の起点となる自己紹介サイト。`}
  path="/"
  ogType="website"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <section class="hero">
    <p class="kana">Hatano Takuma</p>
    <h1>{profile.name_ja}</h1>
    <p class="tagline">{profile.tagline}</p>

    {lede && <p class="lede">{lede}</p>}

    {profile.links.length > 0 && (
      <ul class="hero-links">
        {profile.links.map((l) => (
          <li>
            <ExternalLink href={l.url}>{l.label}</ExternalLink>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="section products" id="products" aria-labelledby="products-heading">
    <h2 id="products-heading">プロダクト・開発したもの</h2>
    {products.length === 0 ? (
      <p class="empty">プロダクト情報はまだありません。</p>
    ) : (
      <ul class="product-grid">
        {products.map((p) => {
          const iconChar = p.data.icon ?? defaultProductIcon(p.data.name);
          return (
            <li class="product-cell-wrap">
              <a href={url(`/products/${p.id}/`)} class="product-cell">
                <span class="product-icon" aria-hidden="true">{iconChar}</span>
                <span class="product-name">{p.data.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  <section class="section preview" aria-labelledby="preview-talks">
    <h2 id="preview-talks">直近の発表</h2>
    {talks.length === 0 ? (
      <p class="empty">まだ登壇情報はありません。</p>
    ) : (
      <ul class="rows">
        {talks.map((t) => (
          <li>
            <EntryRow date={formatDate(t.data.date)} dateTime={t.data.date} badge={talkTypeLabel[t.data.type]}>
              <h3 class="row-title"><a href={url(`/talks/${t.id.replace(/\.md$/u, '')}/`)}>{t.data.title}</a></h3>
              <p class="row-meta">{t.data.event}{t.data.location ? `（${t.data.location}）` : ''}</p>
            </EntryRow>
          </li>
        ))}
      </ul>
    )}
    <p class="more"><a href={url('/talks/')}>すべての発表を見る →</a></p>
  </section>

  <section class="section preview" aria-labelledby="preview-pubs">
    <h2 id="preview-pubs">直近の論文・寄稿</h2>
    {publications.length === 0 ? (
      <p class="empty">まだ論文・寄稿はありません。</p>
    ) : (
      <ul class="rows">
        {publications.map((p) => (
          <li>
            <EntryRow date={formatDate(p.data.date)} dateTime={p.data.date} badge={publicationTypeLabel[p.data.type]}>
              <h3 class="row-title"><a href={url(`/publications/${p.id.replace(/\.md$/u, '')}/`)}>{p.data.title}</a></h3>
              <p class="row-meta">{p.data.venue}</p>
            </EntryRow>
          </li>
        ))}
      </ul>
    )}
    <p class="more"><a href={url('/publications/')}>すべての論文・寄稿を見る →</a></p>
  </section>

  <section class="section preview" aria-labelledby="preview-career">
    <h2 id="preview-career">経歴</h2>
    <ul class="rows">
      {careerEntries.map((c) => (
        <li>
          <EntryRow date={`${formatYearMonth(c.data.period_start)}〜${formatYearMonth(c.data.period_end)}`}>
            <h3 class="row-title">{c.data.organization}</h3>
            <p class="row-meta">{c.data.role}</p>
          </EntryRow>
        </li>
      ))}
    </ul>
    <p class="more"><a href={url('/career/')}>すべての経歴を見る →</a></p>
  </section>

  {restBio.length > 0 && (
    <section class="section bio-rest" aria-labelledby="bio-rest-heading">
      <h2 id="bio-rest-heading">もう少し詳しく</h2>
      {restBio.map((p) => <p>{p}</p>)}
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-6);
  }
  .kana {
    color: var(--c-text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .hero h1 {
    font-size: clamp(1.85rem, 1.4rem + 1.6vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    font-weight: 600;
  }
  .tagline {
    margin-top: var(--space-2);
    color: var(--c-text);
    font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
    max-width: var(--measure-prose);
  }
  .lede {
    margin-top: var(--space-4);
    max-width: var(--measure-prose);
  }
  .hero-links {
    list-style: none;
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    font-size: 0.92rem;
  }

  .section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--c-rule);
  }
  .section h2 {
    font-size: 1.15rem;
    margin-bottom: var(--space-4);
    letter-spacing: 0.02em;
  }

  /* Products grid: 4 列 desktop / 2 列 tablet / 1 列 mobile。
     セルごとに細い罫線を持たせ、最終行が埋まらない場合に空白が広がらないようにする。 */
  .product-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .product-cell-wrap {
    /* 行が浮かないように li 自体は装飾しない */
  }
  .product-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
    height: 100%;
    min-height: 9rem;
    border: 1px solid var(--c-rule);
    border-radius: 4px;
    transition:
      background var(--duration-quick) var(--easing-quick),
      border-color var(--duration-quick) var(--easing-quick);
  }
  .product-cell:hover {
    background: var(--c-bg-elev);
    border-color: var(--c-rule-strong);
  }
  .product-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--c-rule-strong);
    border-radius: 4px;
    font-size: 1.35rem;
    font-weight: 500;
    font-family: var(--font-serif);
    color: var(--c-accent);
    flex-shrink: 0;
  }
  .product-name {
    display: inline-block;
    align-self: flex-start;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--c-text);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-quick) var(--easing-quick);
  }
  .product-cell:hover .product-name {
    border-bottom-color: var(--c-accent);
  }

  @media (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Preview sections (talks/pubs/career) */
  .rows {
    list-style: none;
  }
  .row-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .row-title a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .row-title a:hover {
    border-bottom-color: var(--c-accent);
  }
  .row-meta {
    color: var(--c-text-muted);
    font-size: 0.92rem;
    margin-top: var(--space-1);
  }
  .more {
    margin-top: var(--space-4);
    color: var(--c-text-muted);
    font-size: 0.92rem;
  }
  .empty {
    color: var(--c-text-muted);
    padding-block: var(--space-3);
  }

  /* Bio rest */
  .bio-rest {
    color: var(--c-text);
  }
  .bio-rest p {
    max-width: var(--measure-prose);
  }
  .bio-rest p + p {
    margin-top: 1em;
  }
</style>

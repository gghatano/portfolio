---
import { type CollectionEntry, getCollection } from 'astro:content';
import ExternalLink from '~/components/lists/ExternalLink.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatYearMonth } from '~/lib/format';
import { defaultProductIcon } from '~/lib/products';
import { url } from '~/lib/url';

export async function getStaticPaths() {
  const items = await getCollection('products');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props {
  item: CollectionEntry<'products'>;
}
const { item } = Astro.props;
const d = item.data;
const period = d.period_start
  ? `${formatYearMonth(d.period_start)}${d.period_end ? `〜${formatYearMonth(d.period_end)}` : ''}`
  : '';
const iconChar = d.icon ?? defaultProductIcon(d.name);
const descParagraphs = d.description_md ? d.description_md.split(/\n\n+/u) : [];

const productJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.name,
  description: d.tagline,
};
if (d.period_start) productJsonLd.dateCreated = d.period_start;
if (d.role) productJsonLd.creator = { '@type': 'Person', name: '畑野 拓馬', roleName: d.role };
---

<BaseLayout
  title={d.name}
  description={d.tagline}
  path={`/products/${item.id}/`}
  ogType="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />

  <nav class="crumb" aria-label="パンくず">
    <a href={url('/')}>ホーム</a>
    {' / '}
    <a href={url('/#products')}>プロダクト</a>
    {' / '}
    <span aria-current="page">{d.name}</span>
  </nav>

  <article class="detail">
    <header class="head">
      <span class="icon" aria-hidden="true">{iconChar}</span>
      <div class="head-text">
        <h1>{d.name}</h1>
        {(d.role || period) && (
          <p class="meta">
            {d.role && <span>{d.role}</span>}
            {period && <span class="period">{period}</span>}
          </p>
        )}
      </div>
    </header>

    <p class="tagline">{d.tagline}</p>

    {d.tech && d.tech.length > 0 && (
      <ul class="tech" aria-label="使用技術">
        {d.tech.map((t) => <li>{t}</li>)}
      </ul>
    )}

    {descParagraphs.length > 0 && (
      <div class="description">
        {descParagraphs.map((p) => <p>{p}</p>)}
      </div>
    )}

    {d.links && d.links.length > 0 && (
      <section class="links" aria-label="関連リンク">
        <h2>関連リンク</h2>
        <ul>
          {d.links.map((l) => (
            <li><ExternalLink href={l.url}>{l.label}</ExternalLink></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .crumb {
    color: var(--c-text-muted);
    font-size: 0.85rem;
    margin-bottom: var(--space-5);
  }
  .crumb a {
    color: var(--c-text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .crumb a:hover {
    color: var(--c-text);
    border-bottom-color: var(--c-rule-strong);
  }

  .detail {
    max-width: var(--measure-prose);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--c-rule);
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--c-rule-strong);
    border-radius: 6px;
    font-size: 2rem;
    font-weight: 500;
    font-family: var(--font-serif);
    color: var(--c-accent);
    flex-shrink: 0;
  }
  .head-text h1 {
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.85rem);
    line-height: 1.3;
  }
  .meta {
    margin-top: var(--space-2);
    color: var(--c-text-muted);
    font-size: 0.88rem;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .meta span + span::before {
    content: '·';
    margin-inline-end: var(--space-3);
    color: var(--c-rule-strong);
  }
  .period {
    font-variant-numeric: tabular-nums;
  }

  .tagline {
    margin-top: var(--space-5);
    color: var(--c-text);
    font-size: 1.05rem;
  }

  .tech {
    list-style: none;
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tech li {
    font-size: 0.78rem;
    color: var(--c-text-muted);
    border: 1px solid var(--c-rule);
    border-radius: 4px;
    padding: 0.1rem 0.55rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .description {
    margin-top: var(--space-6);
  }
  .description p + p {
    margin-top: 1em;
  }

  .links {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-rule);
  }
  .links h2 {
    font-size: 1rem;
    margin-bottom: var(--space-3);
  }
  .links ul {
    list-style: none;
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    font-size: 0.95rem;
  }

  @media (max-width: 600px) {
    .head {
      gap: var(--space-4);
    }
    .icon {
      width: 3.25rem;
      height: 3.25rem;
      font-size: 1.6rem;
    }
  }
</style>

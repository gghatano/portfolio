---
import ExternalLink from '~/components/lists/ExternalLink.astro';
import SectionHeader from '~/components/lists/SectionHeader.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

const xHandle = 'gg_hatano';
const xUrl = `https://x.com/${xHandle}`;

const socials = [
  { label: 'X (Twitter)', url: xUrl },
  { label: 'GitHub', url: 'https://github.com/gghatano' },
];
---

<BaseLayout
  title="連絡先"
  description="X (Twitter) の DM など連絡手段の一覧。"
  path="/contact/"
>
  <SectionHeader eyebrow="Contact" title="連絡先" lead="登壇・寄稿・取材のご相談はこちらからお願いします。" />

  <div class="lede">
    <p>ご連絡は X (Twitter) の DM でお願いしています。返信は数日〜1 週間程度かかることがあります。</p>
  </div>

  <dl class="contacts">
    <dt>X (Twitter)</dt>
    <dd>
      <ExternalLink href={xUrl} label={`@${xHandle}`} />
      <small>DM またはメンションでご連絡ください。</small>
    </dd>
    <dt>SNS</dt>
    <dd>
      <ul class="socials">
        {socials.map((s) => (
          <li><ExternalLink href={s.url} label={s.label} /></li>
        ))}
      </ul>
    </dd>
  </dl>
</BaseLayout>

<style>
  .lede { max-width: var(--measure-prose); margin-bottom: var(--space-6); color: var(--c-text-muted); }
  .contacts {
    display: grid;
    grid-template-columns: 8rem 1fr;
    column-gap: var(--space-5);
    row-gap: var(--space-4);
    border-top: 1px solid var(--c-rule);
    padding-top: var(--space-5);
  }
  .contacts dt {
    font-size: 0.85rem;
    color: var(--c-text-muted);
    letter-spacing: 0.06em;
  }
  .contacts dd {
    margin: 0;
  }
  .contacts dd small { display: block; margin-top: var(--space-2); color: var(--c-text-muted); }
  .socials { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); }
  @media (max-width: 600px) {
    .contacts { grid-template-columns: 1fr; row-gap: var(--space-2); }
    .contacts dt { padding-top: var(--space-3); }
  }
</style>

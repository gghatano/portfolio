---
interface Props {
  title: string;
  description: string;
  /** root-relative なロジカルパス。`/career/` のように渡し、BASE_URL は内部で付与する。 */
  path?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
}

const { title, description, path, ogType = 'website', ogImage } = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://example.github.io/';
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');

// path が指定されていれば BASE_URL を頭に付けて site と結合する。
// 未指定なら Astro.url.pathname を使う（ビルド時に既に BASE_URL を含んだ絶対パス）。
const fullPath = path ? `${base}${path.startsWith('/') ? path : `/${path}`}` : Astro.url.pathname;
const canonical = new URL(fullPath, siteUrl).toString();

// OG 画像はサイト共通テンプレを `public/og/default.png` として置く運用にしているが、
// 公開先確定前は空にしておく（404 を踏ませない方が良い）。
const og = ogImage ? new URL(`${base}/${ogImage.replace(/^\//, '')}`, siteUrl).toString() : null;
const twitterCard = og ? 'summary_large_image' : 'summary';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
{og && <meta property="og:image" content={og} />}
<meta property="og:locale" content="ja_JP" />

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{og && <meta name="twitter:image" content={og} />}

---
/**
 * 一覧の 1 行。年表ふうに左に日付、右にコンテンツ。
 * dateTime が ISO 形式で渡されたときのみ <time datetime> を出す。
 */
interface Props {
  date: string;
  dateTime?: string;
  badge?: string;
}
const { date, dateTime, badge } = Astro.props;
---

<article class="row">
  <div class="meta">
    {dateTime ? (
      <time datetime={dateTime} class="date">{date}</time>
    ) : (
      <span class="date">{date}</span>
    )}
    {badge && <span class="badge">{badge}</span>}
  </div>
  <div class="body">
    <slot />
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--c-rule);
  }
  .row:last-child {
    border-bottom: none;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .date {
    color: var(--c-text-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .badge {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
    border: 1px solid var(--c-rule);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .meta {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
    }
  }
</style>

---
interface Props {
  href: string;
  label?: string;
}
const { href, label } = Astro.props;
---
<a href={href} target="_blank" rel="noopener noreferrer" class="ext">
  <slot>{label ?? href}</slot>
  <span aria-hidden="true" class="arrow">↗</span>
  <span class="sr-only">（新しいタブで開く）</span>
</a>

<style>
  .ext {
    white-space: nowrap;
  }
  .arrow {
    margin-inline-start: 0.15em;
    font-size: 0.85em;
    color: var(--c-text-muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

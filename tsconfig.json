{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": false,
		"baseUrl": ".",
		"paths": {
			"~/*": [
				"src/*"
			]
		}
	},
	"include": [
		"src",
		".astro/types.d.ts",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}